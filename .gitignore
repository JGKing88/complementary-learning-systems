# --- run outputs (moved to $CLS_RUNS on pool; repo entries are symlinks) ---
wandb/
slurm_outputs/
encoders/
checkpoints/
checkpoint/

# --- large binaries ---
*.pt
*.pth
*.npy
*.npz
*.pkl
*.pt.tar
*.pt.tar.gz
*.pt.tar.bz2
*.pt.tar.xz
*.pt.tar.lzma

# --- figures ---
*.eps
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.webp
*.svg

# --- python / tooling ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# --- job + run logs ---
slurm-*.out
*.out
*.json
*.log

# --- exceptions -----------------------------------------------------------
# Golden regression fixtures are checked in on purpose: they are the contract
# that the refactor preserves behavior. Regenerating them is deliberate
# (tests/gen_golden.py), never automatic.
!**/tests/golden/
!**/tests/golden/**
