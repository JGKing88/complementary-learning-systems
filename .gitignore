# --- run outputs -----------------------------------------------------------
# These were migrated to $CLS_RUNS on pool in 2026-08; what remains in the tree
# is a symlink under the old name, so that relative paths saved inside old
# checkpoints keep resolving. No trailing slashes: a symlink to a directory is
# not a directory as far as gitignore is concerned.
slurm_outputs
wandb
encoders
checkpoints
checkpoint
checkpoint_rnn
plots
images
results
npos_sweep
displacement_plots
smoke_pd2
smoke_seq
encoder_training/sweeps
hopfield_nav/logs
hopfield_nav/eval_results
hopfield_nav/eval_all
hopfield_nav/diagnostics
hopfield_nav/inspect
hopfield_nav/trajectory_plots
analysis/phase_decoding_v1_results
analysis/phase_decoding/results
analysis/continual/histories
analysis/continual/scaffold_cache
analysis/continual/figures
analysis/continual/final_figures
analysis/continual/model_comparison

# --- large binaries ---
*.pt
*.pth
*.npy
*.npz
*.pkl
*.pt.tar
*.pt.tar.gz
*.pt.tar.bz2
*.pt.tar.xz
*.pt.tar.lzma

# --- figures ---
*.eps
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.webp
*.svg

# --- python / tooling ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# --- job + run logs ---
slurm-*.out
*.out
*.json
*.log

# --- exceptions -----------------------------------------------------------
# Golden regression fixtures are checked in on purpose: they are the contract
# that the refactor preserves behavior. Regenerating them is deliberate
# (tests/gen_golden.py), never automatic.
!**/tests/golden/
!**/tests/golden/**

# Agent worktrees: full repo copies, checked out under the repo root.
.claude/worktrees/

# NFS silly-rename artefacts. NFS renames a still-open file to .nfsXXXX when
# it is deleted, so editing a script while a background job has it open leaves
# one behind -- and `git add -A` will happily commit it.
.nfs*
